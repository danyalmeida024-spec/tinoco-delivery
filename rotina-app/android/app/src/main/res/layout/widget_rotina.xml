<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="18dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MINHA ROTINA"
            android:textColor="#5DC39B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/w_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toque para abrir"
            android:textColor="#ECF2EE"
            android:textSize="19sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_done"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginStart="10dp"
        android:gravity="center"
        android:text="✓"
        android:textColor="#0A1912"
        android:textSize="26sp"
        android:textStyle="bold"
        android:background="@drawable/widget_btn"
        android:contentDescription="Marcar como feita" />
</LinearLayout>
